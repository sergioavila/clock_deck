{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clock_deck",
  "version": "1.0.0",
  "identifier": "dev.iori.clockDeck",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "clock_deck",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
